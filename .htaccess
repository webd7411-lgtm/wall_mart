# DO NOT REMOVE. CLOUDLINUX PASSENGER CONFIGURATION BEGIN
PassengerAppRoot "/home3/binsult1/domains/trendhubstore.pk/public_html/frontend"
PassengerBaseURI "/"
PassengerNodejs "/home3/binsult1/nodevenv/domains/trendhubstore.pk/public_html/frontend/20/bin/node"
PassengerAppType node
PassengerStartupFile server.js
# DO NOT REMOVE. CLOUDLINUX PASSENGER CONFIGURATION END
<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews -Indexes
    </IfModule>

    RewriteEngine On

    # 1. Handle Authorization Header
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # 2. Block access to sensitive files
    RewriteRule ^\.env.*$ - [F,L]
    RewriteRule ^composer\.(json|lock)$ - [F,L]
    RewriteRule ^package(-lock)?\.json$ - [F,L]
    RewriteRule ^artisan$ - [F,L]
    RewriteRule ^(app|bootstrap|config|database|resources|routes|storage|tests)(/|$) - [F,L]

    # 3. Serve physical static files directly (images, css, js, fonts)
    RewriteCond %{REQUEST_FILENAME} -f
    RewriteRule ^ - [L]

    # 4. Serve uploads and storage from public folder
    RewriteCond %{DOCUMENT_ROOT}/public/uploads/$1 -f
    RewriteRule ^uploads/(.*)$ public/uploads/$1 [L]

    RewriteCond %{DOCUMENT_ROOT}/public/storage/$1 -f
    RewriteRule ^storage/(.*)$ public/storage/$1 [L]

    # 5. Route Next.js static assets directly from frontend/.next/static
    RewriteRule ^_next/static/(.*)$ frontend/.next/static/$1 [L]

    # 6. Route Next.js public files if they exist in frontend/public
    RewriteCond %{DOCUMENT_ROOT}/frontend/public/$1 -f
    RewriteRule ^(.+)$ frontend/public/$1 [L]

    # 7. Route Software, ERP, API and Admin routes to Laravel index.php
    RewriteCond %{REQUEST_URI} ^/(api|software|sanctum|home|pos|sale|sales|Purchase|purchases?|purchase-pos|add/Purchase|InwardGatepass|inward-gatepass|add/InwardGatepass|product-catalog|products-list|productget|productview|create_prodcut|store-product|generate-barcode-image|customers?|salecustomers|customer-payments|vendor|vendors?|vendors-ledger|warehouses?|warehouse_stocks|warehouse-stock.*|stock_transfers|stock-adjustments|stock|stocks|branch|roles|permissions|users|zone|zones|sales-officers|bookings?|booking|vouchers|all_recepit_vochers|all_Payment_vochers|all_expense_vochers|recepit_vochers|Payment_vochers|expense_vochers|store_rec_vochers|store_Pay_vochers|store_expense_vochers|print|Paymentprint|expenseprint|report|reports|website-settings|web-orders|web-products|coupons|web-users|checkbook|day-closing|drawer-transaction|notifications|discount|category|categories|subcategory|subcategories|Brand|brands|Unit|units|expense-categories|profile|accounts|accounts-head|view_all|narrations|party-list|receipt-vouchers|invoice-series|search-products|search-product-name|get-.*|getOpeningBalance|hr|my-attendance|debug-perms|confirm-password|forgot-password|reset-password|settings|modules|admin|logout|verify-email|index\.php) [NC]
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [L,QSA]
</IfModule>

# Disable Passenger for Laravel's index.php so PHP handles it
<Files "index.php">
    <IfModule mod_passenger.c>
        PassengerEnabled off
    </IfModule>
</Files>

# DO NOT REMOVE OR MODIFY. CLOUDLINUX ENV VARS CONFIGURATION BEGIN
<IfModule Litespeed>
</IfModule>
# DO NOT REMOVE OR MODIFY. CLOUDLINUX ENV VARS CONFIGURATION END
